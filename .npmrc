# O better-sqlite3 já traz binários prontos (N-API). Sem esta linha o npm tentaria
# compilá-lo com o Visual Studio (node-gyp) e, ao falhar, apagaria o node_modules.
# O binário do Electron é baixado por scripts/ensure-electron.mjs na primeira vez que
# o app, o pacote ou os testes E2E rodam.
ignore-scripts=true
